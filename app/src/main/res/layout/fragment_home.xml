<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/beige">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp">

        <!-- Logo -->
        <ImageView
            android:id="@+id/imageViewLogo"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:src="@drawable/logo_app"
            android:contentDescription="ChattyAI Logo" />

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Welcome to"
            android:textColor="@android:color/black"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Nombre de la app -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nagomi Atoru 👋"
            android:textColor="@color/green"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Texto descriptivo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Start this fantastic trip"
            android:textColor="@android:color/darker_gray"
            android:textSize="16sp" />

        <!-- SECCIÓN DE BOTONES DE RECOMENDACIÓN -->
        <View android:layout_height="24dp" android:layout_width="match_parent"/> <!-- Espaciado -->

        <!-- Botón 1: Recetas con atole -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_recetas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recomendar recetas con atole"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:paddingVertical="12dp"
            android:paddingStart="12dp"
            app:icon="@drawable/ic_food"
            app:iconPadding="8dp"
            app:iconSize="24dp"
            app:iconGravity="textStart"
            android:layout_marginTop="8dp" />

        <!-- Botón 2: Gimnasios cercanos -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_gimnasios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recomendar gimnasios cercanos"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:paddingVertical="12dp"
            android:paddingStart="12dp"
            app:icon="@drawable/ic_sports"
            app:iconPadding="8dp"
            app:iconSize="24dp"
            app:iconGravity="textStart"
            android:layout_marginTop="8dp" />

        <!-- Botón 3: Clínicas por especialidad -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_clinicas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recomendar clínicas por especialidad"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:paddingVertical="12dp"
            android:paddingStart="12dp"
            app:icon="@drawable/ic_clinic"
            app:iconPadding="8dp"
            app:iconSize="24dp"
            app:iconGravity="textStart"
            android:layout_marginTop="8dp" />

        <!-- Botón 4: Lugares recreativos cercanos -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_recreacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recomendar lugares recreativos cercanos"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:paddingVertical="12dp"
            android:paddingStart="12dp"
            app:icon="@drawable/ic_recreacion"
            app:iconPadding="8dp"
            app:iconSize="24dp"
            app:iconGravity="textStart"
            android:layout_marginTop="8dp" />


    </LinearLayout>
</ScrollView>
